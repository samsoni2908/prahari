# ==============================================================================
# PRAHARI — Environment Configuration Template
# SIH 26186 — AI-Powered Personnel Stress and Welfare Monitoring System
# Copy this file to .env and adjust variables for your local development environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="PRAHARI"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Backend Server
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prahari
POSTGRES_USER=prahari_app
POSTGRES_PASSWORD=change-me-local-only
# Superuser for initial schema migrations and role creation only
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only

# Database URL for async SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database URL for Alembic migrations (sync psycopg / psycopg2)
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Generate a unique random value of at least 32 bytes. Never reuse this example value.
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# Policy & Privacy Configuration
# ------------------------------------------------------------------------------
# Aggregation floor: minimum squad/section size required to show aggregate operational metrics
AGGREGATION_FLOOR=5

# Deterministic seed for reproducible synthetic dataset generation
SYNTHETIC_DATA_SEED=26186
# Required only when importing synthetic demo users; choose a unique 12+ character value.
PRAHARI_DEMO_PASSWORD=

# Default WSI weights: D, R, C, N, L, H, S
WSI_WEIGHT_D=0.25
WSI_WEIGHT_R=0.20
WSI_WEIGHT_C=0.15
WSI_WEIGHT_N=0.15
WSI_WEIGHT_L=0.10
WSI_WEIGHT_H=0.10
WSI_WEIGHT_S=0.05
