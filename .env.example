# SWASTI — Environment Configuration Template
# Copy this file to .env and provide your specific deployment values

# Environment Mode
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=SWASTI

# Ports & Hosts
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=swasti_db
POSTGRES_USER=swasti_user
POSTGRES_PASSWORD=your_secure_postgres_password

# Database URLs
DATABASE_URL=postgresql+asyncpg://swasti_user:your_secure_postgres_password@postgres:5432/swasti_db
DATABASE_URL_SYNC=postgresql://swasti_user:your_secure_postgres_password@postgres:5432/swasti_db

# Security & Sessions (Generate a strong 32+ character key with: openssl rand -hex 32)
SECRET_KEY=your_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Demo Prototype Credentials (for evaluation)
DEMO_PASSWORD=your_evaluation_password

# CORS & Networking
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=/api/v1

# Operational & Privacy Parameters
AGGREGATION_FLOOR=5
SYNTHETIC_DATA_SEED=26186
